<div class="layout layout--col gap--small mesh-compact">
  <div class="mesh-header gap--distribute pb--2">
    <div><div class="label">MESHTASTIC NODE</div><div class="title">{{ node.name }}</div></div>
    <div class="mesh-badge rounded--full px--2 py--1">{{ node.channel }}</div>
  </div>
  <div class="grid grid--cols-2 gap--small">
    <div class="mesh-kpi p--2 rounded"><span class="label label--small">ONLINE NODES</span><span class="mesh-kpi__value">{{ node.metrics.nodes_online }}</span></div>
    <div class="mesh-kpi p--2 rounded"><span class="label label--small">NEIGHBORS</span><span class="mesh-kpi__value">{{ node.metrics.neighbor_count }}</span></div>
  </div>
  <div class="mesh-card rounded">
    <div class="mesh-card__heading gap--distribute px--2 py--1"><span class="title title--small">NODE METRICS</span><span class="label label--small">{{ node.channel }}</span></div>
    <div class="p--2">
      <div class="mesh-stat-row gap--distribute py--1"><span class="title title--small">Channel util.</span><span class="label">{{ node.metrics.channel_utilization }}%</span></div>
      <div class="mesh-stat-row gap--distribute py--1"><span class="title title--small">Air util. TX</span><span class="label">{{ node.metrics.air_util_tx }}%</span></div>
      <div class="mesh-stat-row gap--distribute py--1"><span class="title title--small">Packets RX</span><span class="label">{{ node.metrics.packets_received }}</span></div>
      <div class="mesh-stat-row gap--distribute py--1"><span class="title title--small">Packets TX</span><span class="label">{{ node.metrics.packets_sent }}</span></div>
      <div class="mesh-stat-row gap--distribute py--1"><span class="title title--small">Relayed</span><span class="label">{{ node.metrics.packets_relayed }}</span></div>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">{{ trmnl.plugin_settings.instance_name }}</span><span class="instance">{{ node.id }} &middot; {{ node.uptime }} &middot; {{ node.last_contact }}</span></div>
