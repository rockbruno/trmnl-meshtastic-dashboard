    border: 2px solid #000;
    border-radius: 10px;
    overflow: hidden;
  }

  .mesh-card__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 10px;
    border-bottom: 2px solid #000;
    background: #000;
    color: #fff;
  }

  .mesh-card__body { padding: 10px; }

