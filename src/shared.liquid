{% capture meshtastic_logo %}
<svg class="mesh-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" role="img" aria-label="Meshtastic">
  <defs>
    <clipPath id="mesh-logo-corners">
      <rect width="512" height="512" rx="64" ry="64" />
    </clipPath>
  </defs>
  <g clip-path="url(#mesh-logo-corners)">
    <path fill="#67ea94" d="M0 0h512v512H0z" />
    <g transform="matrix(1.79 0 0 1.79 313.74 258.36)">
      <path fill="#2c2d3c" fill-rule="evenodd" transform="translate(-250.97 -362.41)" d="M250.908 330.267 193.126 415.005 180.938 406.694 244.802 313.037a7.374 7.374 0 0 1 6.087-3.221 7.374 7.374 0 0 1 6.093 3.21l64.012 93.51-12.173 8.333-57.913-84.602Z" />
    </g>
    <g transform="matrix(1.81 0 0 1.81 145 256.15)">
      <path fill="#2c2d3c" fill-rule="evenodd" transform="translate(-115.14 -528.06)" d="m87.642 581.398 67.115-98.421-12.119-8.264-67.115 98.421 12.119 8.264Z" />
    </g>
  </g>
</svg>
{% endcapture %}

<style>
  .mesh-header {
    display: flex;
    align-items: flex-end;
    border-bottom: 3px solid #000;
  }

  .mesh-identity {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mesh-logo {
    width: 44px;
    height: 44px;
    display: block;
  }

  .mesh-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 2px solid #000;
    font: 700 14px/1 sans-serif;
    letter-spacing: .08em;
  }

  .mesh-card {
    border: 2px solid #000;
    overflow: hidden;
  }

  .mesh-card__heading {
    display: flex;
    align-items: center;
    border-bottom: 2px solid #000;
    background: #000;
    color: #fff;
  }

  .mesh-card__heading .title,
  .mesh-card__heading .label { color: #fff; }

  .mesh-kpi { border: 2px solid #000; }

  .mesh-kpi__value {
    display: block;
    font: 700 32px/.95 sans-serif;
  }

  .mesh-meter {
    height: 13px;
    border: 2px solid #000;
    overflow: hidden;
  }

  .mesh-meter__fill { height: 100%; background: #000; }

  .mesh-stat-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-bottom: 1px solid #000;
  }

  .mesh-stat-row:last-child { border-bottom: 0; }
  .mesh-radio-health .mesh-stat-row { border-bottom: 0; }

  .mesh-big-number {
    font: 700 52px/.85 sans-serif;
    letter-spacing: -.05em;
  }

  .mesh-compact .mesh-big-number { font: 700 46px/.85 sans-serif; }
  .mesh-compact .mesh-kpi__value { font: 700 25px/.95 sans-serif; }

  .mesh-message {
    border-left: 6px solid #000;
    background: repeating-linear-gradient(-45deg, #fff, #fff 5px, #eee 5px, #eee 6px);
  }

  .mesh-message__text {
    display: block;
    font: 600 15px/1.15 sans-serif;
  }

  .screen--lg .mesh-header { border-bottom-width: 4px; }
  .screen--lg .mesh-logo { width: 64px; height: 64px; }
  .screen--lg .mesh-badge { font: 700 18px/1 sans-serif; border-width: 3px; }
  .screen--lg .mesh-kpi { border-width: 3px; }
  .screen--lg .mesh-kpi__value { font: 700 43px/.95 sans-serif; }
  .screen--lg .mesh-card { border-width: 3px; }
  .screen--lg .mesh-card__heading { border-bottom-width: 3px; }
  .screen--lg .mesh-stat-row { border-bottom-width: 2px; }
  .screen--lg .mesh-big-number { font: 700 56px/.85 sans-serif; }
  .screen--lg .mesh-message { border-left-width: 9px; }
  .screen--lg .mesh-message__text { font: 600 15px/1.15 sans-serif; }
  .screen--4bit .mesh-kpi { background: #f1f1f1; }
  .screen--4bit .mesh-message { background: #e5e5e5; }
</style>
